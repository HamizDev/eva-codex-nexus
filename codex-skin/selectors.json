{
  "schema": "eva-codex-skin-selectors/1",
  "verifiedAgainst": {
    "codexVersion": "26.1106.6628.0",
    "platform": "windows",
    "renderer": "Chromium 157.0.8103.51",
    "date": "2026-11-11",
    "note": "只使用稳定属性、语义标签和 CSS Module 前缀，不匹配完整 hash。"
  },
  "selectors": {
    "shellMain": "main:is(.main-surface, [data-app-shell-main-surface], [class*=\"_MainContentSurface_\"]), main",
    "sidebar": "aside.app-shell-left-panel",
    "header": "header:is(.app-header-tint, [data-app-shell-header-edge-scroll], [class*=\"_Header_\"])",
    "homeIcon": "[data-testid=\"home-icon\"]",
    "homeRoute": "[role=\"main\"]:has([data-testid=\"home-icon\"]), [role=\"main\"]",
    "composer": ":is(.composer-surface-chrome, [class*=\"_ComposerLayoutRoot_\"], [data-composer-surface-variant][data-composer-radius-variant])",
    "composerInput": "textarea, [contenteditable=\"true\"], [role=\"textbox\"], .ProseMirror",
    "markdown": "[class*=\"_markdown\"]",
    "threadSurface": ".thread-scroll-container",
    "message": ":is([data-message-author-role], [data-local-conversation-user-anchor], [data-local-conversation-final-assistant])",
    "settingsPanel": "[data-settings-panel-slug], input[name=\"appearance-theme\"]",
    "overlayMenu": "[role=\"menu\"]",
    "overlayDialog": "[role=\"dialog\"]",
    "tooltip": "[role=\"tooltip\"]",
    "overlayPopper": "[data-radix-popper-content-wrapper]",
    "brandedSurface": "[data-testid=\"app-shell-header-context-menu-surface\"]",
    "elevatedSurface": "[class*=\"bg-surface-elevated-secondary\"]",
    "neutralSoftAction": "[class*=\"bg-background-neutral-soft-alpha\"]",
    "userMessage": ".bg-user-message",
    "composerPrimary": ".bg-composer-primary"
  },
  "excludedTargets": {
    "avatarOverlay": "app://-/index.html?initialRoute=/avatar-overlay"
  }
}
